{
  "$id": "https://github.com/nitishsjsucs/peoplelake/contracts/load-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "lake": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "const": "peoplelake.raw_events"
            },
            "from_snapshot": {
              "type": [
                "string",
                "null"
              ]
            },
            "to_snapshot": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshots_read": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fallback_full_scan": {
              "type": "boolean"
            }
          },
          "required": [
            "table",
            "from_snapshot",
            "to_snapshot",
            "snapshots_read",
            "fallback_full_scan"
          ],
          "additionalProperties": false
        },
        "rows_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rows_inserted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicate_deliveries_skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unique_new_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_max_load_seq": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "min_effective_date_new": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_histogram_10s": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "warehouse": {
          "type": "string",
          "enum": [
            "duckdb",
            "bigquery"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "job_id",
        "run_id",
        "attempt",
        "status",
        "lake",
        "rows_read",
        "rows_inserted",
        "duplicate_deliveries_skipped",
        "unique_new_events",
        "raw_max_load_seq",
        "min_effective_date_new",
        "received_histogram_10s",
        "warehouse",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "failed",
            "expired"
          ]
        },
        "error": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "job_id",
        "run_id",
        "attempt",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
