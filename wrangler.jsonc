{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Never the production name: a plain `wrangler deploy` cannot replace production.
  // Deploy production only with `npm run deploy`.
  "name": "peoplelake-local",
  "workers_dev": false,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The dashboard (web/, built by `npm run build:web` into web/dist) is served as static assets; the
  // API, ingest and internal routes always run the Worker first. Inherited by env.production.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/internal/*", "/dev/*"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_MODE": "dev",
    "LAKE_MODE": "local",
    "RUNNER_DISPATCH": "poll",
    "RUNS_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "https://peoplelake-dev.local",
    "ACCESS_AUD": "peoplelake-dev",
    "ACCESS_ROLE_MAP": "{\"emails\":{\"dev@peoplelake.local\":[\"viewer\",\"operator\"]},\"service_tokens\":{\"src-hris.access\":\"source:hris\",\"src-ats.access\":\"source:ats\",\"src-talent.access\":\"source:talent\",\"runner.access\":\"runner\"}}",
    "JOB_LEASE_SECONDS": "60",
    "JOB_CLAIM_TIMEOUT_SECONDS": "30",
    "JOB_MAX_ATTEMPTS": "3",
    "RUN_TIMEOUT_MINUTES": "10",
    "LANDING_ROLL_SECONDS": "60",
    "LANDING_ROLL_MAX_BYTES": "8388608",
    "LANDING_MAX_BUFFER_BYTES": "67108864",
    "HEARTBEAT_MINUTES": "0",
    // Local guards are wide so evals stay fast; production uses the Free plan values below.
    "RUN_MIN_INTERVAL_SECONDS": "0",
    "FAILURE_BACKOFF_BASE_MINUTES": "0",
    "FAILURE_BACKOFF_MAX_MINUTES": "360",
    "AUTO_RUNS_MAX_PER_DAY": "100000",
    "BQ_MONTHLY_BYTES_CAP": "274000000000",
    "RUNNER_SEEN_WINDOW_SECONDS": "10",
    "EVAL_FAULTS_ENABLED": "true",
    "AI_PROVIDER": "stub",
    "AI_MAX_TOKENS": "96",
    "AI_DAILY_NEURON_CAP": "1800",
    "LLM_BASE_URL": "http://127.0.0.1:8150/v1"
  },
  "r2_buckets": [
    { "binding": "LAKE_BUCKET", "bucket_name": "peoplelake-lake-local" },
    { "binding": "REPORTS_BUCKET", "bucket_name": "peoplelake-reports-local" }
  ],
  // One lake-event message per landing roll (SPEC 29.4.1). Locally the batch timeout is shorter so evals
  // do not wait; production uses the values of SPEC 29.6.
  "queues": {
    "producers": [{ "binding": "LAKE_EVENTS", "queue": "peoplelake-lake-events" }],
    "consumers": [
      {
        "queue": "peoplelake-lake-events",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "peoplelake-lake-events-dlq"
      }
    ]
  },
  // Both classes use the SQLite backend (the only one on the Workers Free plan). The migration tag v1 is
  // still free to change: nothing has been deployed.
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "Coordinator" },
      { "name": "LANDING_ROLLER", "class_name": "LandingRoller" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator", "LandingRoller"] }],
  "workflows": [{ "name": "peoplelake-warehouse-run", "binding": "WAREHOUSE_RUN", "class_name": "WarehouseRunWorkflow" }],
  // One cron (1 of the account's 5 Cron Triggers): sweeps and the backstop every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "production": {
      "name": "peoplelake",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "access",
        "LAKE_MODE": "basin",
        "RUNNER_DISPATCH": "cloudrun",
        "RUNS_ENABLED": "__PL_RUNS_ENABLED__",
        "ACCESS_TEAM_DOMAIN": "__PL_ACCESS_TEAM_DOMAIN__",
        "ACCESS_AUD": "__PL_ACCESS_AUD__",
        "ACCESS_ROLE_MAP": "__PL_ACCESS_ROLE_MAP__",
        "GCP_PROJECT": "__PL_GCP_PROJECT__",
        "GCP_REGION": "us-central1",
        "CLOUD_RUN_JOB": "peoplelake-runner",
        "JOB_LEASE_SECONDS": "600",
        "JOB_CLAIM_TIMEOUT_SECONDS": "300",
        "JOB_MAX_ATTEMPTS": "3",
        "RUN_TIMEOUT_MINUTES": "45",
        "LANDING_ROLL_SECONDS": "60",
        "LANDING_ROLL_MAX_BYTES": "8388608",
        "LANDING_MAX_BUFFER_BYTES": "67108864",
        "HEARTBEAT_MINUTES": "0",
        "RUN_MIN_INTERVAL_SECONDS": "240",
        "FAILURE_BACKOFF_BASE_MINUTES": "5",
        "FAILURE_BACKOFF_MAX_MINUTES": "360",
        "AUTO_RUNS_MAX_PER_DAY": "30",
        "BQ_MONTHLY_BYTES_CAP": "274000000000",
        "RUNNER_SEEN_WINDOW_SECONDS": "10",
        "EVAL_FAULTS_ENABLED": "false",
        "AI_PROVIDER": "workers-ai",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_GATEWAY_ID": "peoplelake",
        "AI_MAX_TOKENS": "96",
        "AI_DAILY_NEURON_CAP": "1800"
      },
      // Production only: an `ai` binding makes `wrangler dev` wait for a remote connection, so local runs
      // use llama-server or the stub and tests inject a mocked AI binding.
      "ai": { "binding": "AI" },
      "r2_buckets": [
        { "binding": "LAKE_BUCKET", "bucket_name": "peoplelake-lake" },
        { "binding": "REPORTS_BUCKET", "bucket_name": "peoplelake-reports" }
      ],
      "queues": {
        "producers": [{ "binding": "LAKE_EVENTS", "queue": "peoplelake-lake-events" }],
        "consumers": [
          {
            "queue": "peoplelake-lake-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "peoplelake-lake-events-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "COORDINATOR", "class_name": "Coordinator" },
          { "name": "LANDING_ROLLER", "class_name": "LandingRoller" }
        ]
      },
      "workflows": [{ "name": "peoplelake-warehouse-run", "binding": "WAREHOUSE_RUN", "class_name": "WarehouseRunWorkflow" }],
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
