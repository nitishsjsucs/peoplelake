{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Never the production name: a plain `wrangler deploy` cannot replace production.
  // Deploy production only with `npm run deploy`.
  "name": "peoplelake-local",
  "workers_dev": false,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_MODE": "dev",
    "LAKE_MODE": "local",
    "RUNNER_DISPATCH": "poll",
    "RUNS_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "https://peoplelake-dev.local",
    "ACCESS_AUD": "peoplelake-dev",
    "ACCESS_ROLE_MAP": "{\"emails\":{\"dev@peoplelake.local\":[\"viewer\",\"operator\"]},\"service_tokens\":{\"src-hris.access\":\"source:hris\",\"src-ats.access\":\"source:ats\",\"src-talent.access\":\"source:talent\",\"runner.access\":\"runner\"}}",
    "JOB_LEASE_SECONDS": "60",
    "JOB_CLAIM_TIMEOUT_SECONDS": "30",
    "JOB_MAX_ATTEMPTS": "3",
    "RUN_TIMEOUT_MINUTES": "10",
    "SINK_ROLL_SECONDS": "60",
    "LOCAL_SINK_MAX_RECORDS": "50000",
    "HEARTBEAT_MINUTES": "0",
    "RUNNER_SEEN_WINDOW_SECONDS": "60",
    "EVAL_FAULTS_ENABLED": "true",
    "AI_PROVIDER": "stub",
    "LLM_BASE_URL": "http://127.0.0.1:8150/v1"
  },
  "r2_buckets": [
    { "binding": "LAKE_BUCKET", "bucket_name": "peoplelake-lake-local" },
    { "binding": "REPORTS_BUCKET", "bucket_name": "peoplelake-reports-local" }
  ],
  "queues": {
    "producers": [{ "binding": "LAKE_EVENTS", "queue": "peoplelake-lake-events" }],
    "consumers": [
      {
        "queue": "peoplelake-lake-events",
        "max_batch_size": 50,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "peoplelake-lake-events-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "Coordinator" },
      { "name": "SINK_ROLLER", "class_name": "SinkRoller" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator", "SinkRoller"] }],
  "workflows": [{ "name": "peoplelake-warehouse-run", "binding": "WAREHOUSE_RUN", "class_name": "WarehouseRunWorkflow" }],
  "triggers": { "crons": ["* * * * *"] },
  // Miniflare runs a Pipeline binding offline and its send() discards data; locally the SinkRoller
  // Durable Object is the labeled stand-in for Basin Pipelines (ADR 0003).
  "pipelines": [{ "binding": "RAW_STREAM", "stream": "00000000000000000000000000000000" }],
  "env": {
    "production": {
      "name": "peoplelake",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "access",
        "LAKE_MODE": "basin",
        "RUNNER_DISPATCH": "cloudrun",
        "RUNS_ENABLED": "__PL_RUNS_ENABLED__",
        "ACCESS_TEAM_DOMAIN": "__PL_ACCESS_TEAM_DOMAIN__",
        "ACCESS_AUD": "__PL_ACCESS_AUD__",
        "ACCESS_ROLE_MAP": "__PL_ACCESS_ROLE_MAP__",
        "GCP_PROJECT": "__PL_GCP_PROJECT__",
        "GCP_REGION": "us-central1",
        "CLOUD_RUN_JOB": "peoplelake-runner",
        "BASIN_CATALOG_URI": "__PL_CATALOG_URI__",
        "BASIN_CATALOG_PREFIX": "__PL_CATALOG_PREFIX__",
        "JOB_LEASE_SECONDS": "600",
        "JOB_CLAIM_TIMEOUT_SECONDS": "300",
        "JOB_MAX_ATTEMPTS": "3",
        "RUN_TIMEOUT_MINUTES": "45",
        "SINK_ROLL_SECONDS": "60",
        "HEARTBEAT_MINUTES": "360",
        "RUNNER_SEEN_WINDOW_SECONDS": "60",
        "EVAL_FAULTS_ENABLED": "false",
        "AI_PROVIDER": "workers-ai",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_GATEWAY_ID": "peoplelake"
      },
      "r2_buckets": [{ "binding": "REPORTS_BUCKET", "bucket_name": "peoplelake-reports" }],
      "queues": {
        "consumers": [
          {
            "queue": "peoplelake-lake-events",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "peoplelake-lake-events-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "COORDINATOR", "class_name": "Coordinator" },
          { "name": "SINK_ROLLER", "class_name": "SinkRoller" }
        ]
      },
      "workflows": [{ "name": "peoplelake-warehouse-run", "binding": "WAREHOUSE_RUN", "class_name": "WarehouseRunWorkflow" }],
      "pipelines": [{ "binding": "RAW_STREAM", "stream": "__PL_STREAM_ID__" }],
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
